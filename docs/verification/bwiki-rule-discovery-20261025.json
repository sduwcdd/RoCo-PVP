  "selected_term_evidence": [
    {
      "key": 1003,
      "zh": "脱离",
      "definition": "精灵离场，并选择队伍里一只其他精灵替换入场。本回合入场的精灵免疫此效果。"
    },
    {
      "key": 1005,
      "zh": "迅捷",
      "definition": "通过主动更换精灵的方式入场时，使用第一个能量满足要求，并带有迅捷的技能。"
    },
    {
      "key": 1007,
      "zh": "蓄力",
      "definition": "该技能需要先蓄力1回合，下回合才能释放。蓄力期间免疫所有离场效果。"
    },
    {
      "key": 1010,
      "zh": "迸发",
      "definition": "入场后的首次行动，会获得额外效果。"
    },
    {
      "key": 1015,
      "zh": "应对状态",
      "definition": "若敌方使用状态技能，则本技能应对成功，本次行动必定先手，且触发应对效果。"
    },
    {
      "key": 1016,
      "zh": "应对攻击",
      "definition": "若敌方使用攻击技能，则本技能应对成功，本次行动必定先手，且触发应对效果。使用后，携带的防御技能进入1回合冷却。"
    },
    {
      "key": 1017,
      "zh": "应对防御",
      "definition": "若敌方使用防御技能，则本技能应对成功，本次行动必定先手，且触发应对效果。"
    },
    {
      "key": 1020,
      "zh": "先手",
      "definition": "技能行动的优先级，先手度更高的技能忽略双方精灵速度差异，优先释放，先手度可叠加。"
    },
    {
      "key": 1024,
      "zh": "返场",
      "definition": "精灵离场，并立即入场。本回合入场的精灵免疫此效果。"
    },
    {
      "key": 1026,
      "zh": "紧急脱离",
      "definition": "精灵离场，并随机选择队伍里一只其他精灵替换入场。本回合入场的精灵免疫此效果。"
    },
    {
      "key": 1033,
      "zh": "传动",
      "definition": "回合开始时，带有“传动X”的技能会向下移动X个位置，该效果可叠加。"
    },
    {
      "key": 3005,
      "zh": "连击数",
      "definition": "改变连击次数，仅对有连击的技能生效。"
    },
    {
      "key": 3006,
      "zh": "沙暴",
      "definition": "天气为沙暴时，双方的地系技能能耗减半。"
    },
    {
      "key": 3007,
      "zh": "暴风雪",
      "definition": "天气为暴风雪时，双方每回合结束获得2层冻结。（冰系精灵免疫此效果）"
    },
    {
      "key": 3008,
      "zh": "雨天",
      "definition": "天气为雨天时，双方的水系技能威力+75%。"
    },
    {
      "key": 3009,
      "zh": "离场",
      "definition": "通过主动更换精灵或触发脱离效果的方式下场。（不包括精灵力竭后下场）"
    },
    {
      "key": 3010,
      "zh": "印记",
      "definition": "精灵下场后印记不会消失，新入场的精灵会继承印记效果。精灵最多同时拥有1种正面印记和1种负面印记。"
    },
    {
      "key": 3021,
      "zh": "雷鸣",
      "definition": "天气为雷鸣时，双方每回合结束获得1层引电。（电系精灵免疫此效果）"
    },
    {
      "key": 3022,
      "zh": "引电",
      "definition": "获得2层引电时，立即受到25%生命的电系伤害，并失去2层引电。（电系精灵免疫此效果）"
    },
    {
      "key": 3023,
      "zh": "禁足",
      "definition": "处于禁足状态时，精灵无法离场，且无法获得新的禁足状态。"
    }
  ],
