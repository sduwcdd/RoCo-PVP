        },
        {
          "code": "magic_cleanup_and_cast_moment",
          "detail": "Shared effect1004027 removes BUFF20990010/20990020 with cast_moment=6 while primary results use cast_moment=10. Their event-domain ordering and cleanup are not adapted."
        },
        {
          "code": "magic_action_server_protocol",
          "detail": "RoundPlayerSkillAction validates allowCnt/num/playerMagicRemainCnt, target Drill/Static/Mimic state, then sends CMD_USE_ITEM with target_pet_id/item_id/player_id/target_pet_pos. This client request is not an authoritative local server resolver."
        }
      ]
    }
